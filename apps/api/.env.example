PORT=4000
HOST=0.0.0.0
NODE_ENV=development
DATABASE_PATH=./data/aone.sqlite
# Vercel: connect Turso Storage. Local development can leave these empty.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
JWT_SECRET=generate_a_random_64_character_secret_with_npm_run_setup
ADMIN_NAME=Aone Mart Admin
ADMIN_PHONE=9999999999
ADMIN_PASSWORD=replace_with_a_unique_password
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional Expo push security token. Configure FCM credentials in EAS for Android remote push.
EXPO_ACCESS_TOKEN=
ENABLE_NOTIFICATIONS=false
# Number of reverse proxies. Keep 0 for direct connections; set 1 behind one trusted proxy.
TRUST_PROXY=0
CORS_ORIGINS=
