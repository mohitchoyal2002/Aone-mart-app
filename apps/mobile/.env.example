# Android emulator: http://10.0.2.2:4000
# Physical Android: http://YOUR_COMPUTER_LAN_IP:4000 for local testing.
# Release: your HTTPS backend URL.
EXPO_PUBLIC_API_URL=
# Populate after running eas init, then configure Android FCM credentials.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Preview enables local HTTP. Production builds must use HTTPS.
APP_VARIANT=preview
# Notifications are deferred in the current APK. Enable after Firebase/EAS setup.
ENABLE_NOTIFICATIONS=false
